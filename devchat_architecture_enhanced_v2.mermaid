graph TD
    subgraph GitHub
        GH[Repo & Issues]
    end

    subgraph "Vercel (Frontend)"
        FE[Next.js App]
        subgraph "User Interface"
            CHAT[Chat Interface]
            DASH[Project Dashboard]
            META[Metadata Editor]
            PV[PDF Viewer]
        end
        subgraph "Admin Panel"
            AD_OV[Overview & Costs]
            AD_US[Users & RAGs]
            AD_QU[Quality Monitoring]
            AD_DO[Documents & Jobs]
        end
    end

    subgraph "Railway (Backend)"
        BE[FastAPI Server]
        subgraph "Query Pipeline"
            QP[Query Processor]
            HYDE[HyDE Expansion]
            RR[Cohere Reranker]
            CACHE[Semantic Cache]
        end
        subgraph "Synthesis"
            CL[Claim Ledger]
            MC[MiniCheck Verifier]
        end
        subgraph "APIs"
            API_CHAT[/chat]
            API_DOC[/documents]
            API_ADMIN[/admin/*]
            API_ZOTERO[/zotero/*]
        end
    end

    subgraph "Modal (GPU Workers)"
        MJ[Ingestion Orchestrator]
        MU[MinerU PDF Extraction]
        subgraph "Indexing"
            EMB_D[Dense Embeddings<br/>Cohere embed-v4]
            EMB_S[Sparse Vectors<br/>BM25-style]
        end
    end

    subgraph "External APIs"
        OR[OpenRouter<br/>GPT-4o / Claude / Gemini]
        COH[Cohere API<br/>Embed + Rerank]
        ZOT[Zotero API]
        CREF[CrossRef / OpenAlex]
    end

    subgraph "Supabase"
        AUTH[Auth & JWT]
        subgraph "PostgreSQL"
            DB_RAG[(rag_projects)]
            DB_DOC[(documents)]
            DB_JOB[(processing_jobs)]
            DB_USE[(usage_logs)]
            DB_CHAT[(chat_sessions)]
        end
    end

    subgraph "Qdrant Cloud"
        QD[(Vector Collections)]
        QD_D[Dense Index<br/>1536 dims]
        QD_S[Sparse Index<br/>BM25]
    end

    subgraph "Cloudflare R2"
        R2[(Object Storage)]
        R2_PDF[/pdfs/]
        R2_MD[/markdown/]
        R2_JSON[/metadata.json/]
    end

    subgraph "Langfuse"
        LF[Observability]
        LF_TR[Traces & Spans]
        LF_EX[Experiments]
        LF_PR[Prompts]
        LF_DS[Test Datasets]
    end

    %% ==================== USER FLOWS ====================
    User((User)) -->|HTTPS| FE
    Admin((Admin)) -->|HTTPS| AD_OV

    %% Frontend to Backend
    CHAT -->|REST| API_CHAT
    DASH -->|REST| API_DOC
    META -->|REST| API_DOC
    AD_OV -->|REST| API_ADMIN
    AD_US -->|REST| API_ADMIN
    AD_QU -->|REST| API_ADMIN

    %% ==================== AUTH FLOW ====================
    FE -->|JWT| AUTH
    BE -->|Verify JWT| AUTH
    AUTH --> DB_RAG

    %% ==================== QUERY PIPELINE ====================
    API_CHAT --> QP
    QP --> CACHE
    CACHE -->|Cache Miss| HYDE
    HYDE -->|Expanded Query| COH
    COH -->|Embeddings| QD
    QD -->|Hybrid Search| QD_D
    QD -->|Hybrid Search| QD_S
    QD -->|Top 50 chunks| RR
    RR -->|Cohere rerank| COH
    RR -->|Top 15 chunks| CL

    %% ==================== SYNTHESIS ====================
    CL -->|Claim extraction| OR
    CL -->|Grounded response| OR
    OR -->|Answer + Citations| MC
    MC -->|NLI verification| OR
    MC -->|Verified response| API_CHAT

    %% ==================== OBSERVABILITY ====================
    QP -.->|Trace start| LF_TR
    CL -.->|Generation span| LF_TR
    MC -.->|Score| LF_TR
    LF_TR --> LF

    %% ==================== PDF ACCESS ====================
    PV -->|Presigned URL| R2_PDF
    CHAT -->|Citation click| PV

    %% ==================== INGESTION PIPELINE ====================
    API_DOC -->|Trigger| MJ
    MJ -->|Download PDF| R2_PDF
    MJ --> MU
    MU -->|Page-aware chunks| EMB_D
    MU -->|Page-aware chunks| EMB_S
    EMB_D -->|Cohere embed| COH
    EMB_D -->|Dense vectors| QD_D
    EMB_S -->|Sparse vectors| QD_S
    MU -->|Markdown| R2_MD
    MU -->|Chunk metadata| R2_JSON

    %% ==================== METADATA ENRICHMENT ====================
    API_DOC -->|DOI lookup| CREF
    CREF -->|Title, Authors, Year| DB_DOC

    %% ==================== ZOTERO SYNC ====================
    API_ZOTERO -->|Fetch collections| ZOT
    ZOT -->|PDFs + metadata| R2_PDF
    ZOT -->|Bibliography| DB_DOC

    %% ==================== STORAGE RELATIONSHIPS ====================
    R2 --- R2_PDF
    R2 --- R2_MD
    R2 --- R2_JSON
    QD --- QD_D
    QD --- QD_S

    %% ==================== DATABASE WRITES ====================
    API_DOC --> DB_DOC
    MJ --> DB_JOB
    API_CHAT --> DB_USE
    API_CHAT --> DB_CHAT

    %% ==================== EVALUATION FLOW ====================
    AD_QU -.->|Run experiments| LF_EX
    LF_EX --> LF_DS
    LF_DS -->|Golden queries| API_CHAT
    LF_PR -->|Prompt versions| CL

    %% ==================== CI/CD ====================
    GH -->|Vercel deploy| FE
    GH -->|Railway deploy| BE

    %% ==================== STYLING ====================
    classDef storage fill:#bbdefb,stroke:#1565c0,color:#0d47a1
    classDef compute fill:#ffe0b2,stroke:#e65100,color:#bf360c
    classDef frontend fill:#c8e6c9,stroke:#2e7d32,color:#1b5e20
    classDef user fill:#f3e5f5,stroke:#7b1fa2,color:#4a148c
    classDef external fill:#fff9c4,stroke:#f9a825,color:#f57f17
    classDef observability fill:#e1bee7,stroke:#8e24aa,color:#4a148c
    classDef database fill:#b3e5fc,stroke:#0277bd,color:#01579b
    
    class R2,R2_PDF,R2_MD,R2_JSON,QD,QD_D,QD_S storage
    class BE,QP,HYDE,RR,CACHE,CL,MC,MJ,MU,EMB_D,EMB_S,API_CHAT,API_DOC,API_ADMIN,API_ZOTERO compute
    class FE,CHAT,DASH,META,PV,AD_OV,AD_US,AD_QU,AD_DO frontend
    class User,Admin user
    class OR,COH,ZOT,CREF external
    class LF,LF_TR,LF_EX,LF_PR,LF_DS observability
    class AUTH,DB_RAG,DB_DOC,DB_JOB,DB_USE,DB_CHAT database

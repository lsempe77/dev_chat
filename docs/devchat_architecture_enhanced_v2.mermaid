graph TD
    subgraph GitHub
        GH[Repo & Issues]
    end

    subgraph Vercel
        FE[Next.js Frontend]
        AD[Admin Dashboard]
        PV[PDF Viewer]
    end

    subgraph Railway
        BE[FastAPI Backend]
        QP[Query Processor]
        LLM[LLM Generation]
    end

    subgraph Modal
        MJ[Ingestion Jobs]
        MU[MinerU Extraction]
        EMB[Embedding Generator]
    end

    subgraph Storage
        R2[(Cloudflare R2)]
        R2_PDF[/PDFs/]
        R2_MD[/Markdown + JSON/]
        QD[(Qdrant Vectors)]
    end

    %% User flows
    User((User)) -->|HTTPS| FE
    FE -->|REST/WS| BE

    %% Query & Evidence Path
    BE --> QP
    QP -->|Hybrid Search| QD
    QD -->|Retrieved Chunks| LLM
    LLM -->|Answer + Citations| FE

    %% PDF Access
    BE -->|Presigned URLs| R2
    FE --> PV
    PV -->|Load cited pages| R2_PDF

    %% Ingestion Pipeline
    BE -->|Trigger ingest| MJ
    MJ -->|Download| R2_PDF
    MJ --> MU
    MU -->|Page-aware chunks| EMB
    EMB -->|Index vectors| QD
    MU -->|Markdown + JSON sidecars| R2_MD

    %% Storage structure
    R2 --- R2_PDF
    R2 --- R2_MD

    %% Admin flows
    AD -->|Query metadata| BE
    BE -->|Job status & doc list| AD
    BE -->|Fetch artifacts| R2_MD
    AD -->|Browse documents| R2_MD

    %% CI/CD
    GH -->|PR deploys| FE
    GH -->|Railway deploy| BE

    %% Styling with white/light backgrounds and dark text
    classDef storage fill:#bbdefb,stroke:#1565c0,color:#0d47a1
    classDef compute fill:#ffe0b2,stroke:#e65100,color:#bf360c
    classDef frontend fill:#c8e6c9,stroke:#2e7d32,color:#1b5e20
    classDef user fill:#f3e5f5,stroke:#7b1fa2,color:#4a148c
    
    class R2,R2_PDF,R2_MD,QD storage
    class BE,QP,LLM,MJ,MU,EMB compute
    class FE,AD,PV frontend
    class User user
